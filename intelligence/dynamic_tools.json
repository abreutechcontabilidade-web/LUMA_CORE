{
  "jogo_da_velha": {
    "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nbody { font-family: sans-serif; display: flex; flex-direction: column; align-items: center; }\nbody { background-color: #8b0000 !important; color: white; }</style>\n</head>\n<body>\n<h1>Jogo da Velha Base</h1>\n<div id=\"board\" style=\"display: grid; grid-template-columns: repeat(3, 50px); gap: 5px;\">\n    <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\n</div>\n<script>\n// Logica basica aqui\n\nfunction tocarSom() { var audio = new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg'); audio.play(); }\n</script>\n<button onclick='tocarSom()' style='position:fixed; bottom:10px; right:10px;'>Tocar Som</button></body>\n</html>",
    "features": [
      "cor_vermelha",
      "som"
    ]
  },
  "calculadora": {
    "html": "<!DOCTYPE html><html><head><style>body{background:#1e293b;color:white;display:flex;justify-content:center;align-items:center;height:100vh;} .calc{background:#0f172a;padding:20px;border-radius:10px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}</style></head><body><div class=\"calc\"><input type=\"text\" style=\"grid-column:span 4;padding:10px;font-size:20px;\"><button>7</button><button>8</button><button>9</button><button>/</button><button>4</button><button>5</button><button>6</button><button>*</button><button>1</button><button>2</button><button>3</button><button>-</button><button>0</button><button>.</button><button>=</button><button>+</button></div></body></html>",
    "features": []
  },
