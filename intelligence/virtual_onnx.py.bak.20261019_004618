# -*- coding: utf-8 -*-
import os
import json

class VirtualONNX:
    def __init__(self):
        self.dynamic_tools = {}
        self.db_path = os.path.join(os.path.dirname(__file__), "dynamic_tools.json")
        self._load_dynamic_tools()

    def _load_dynamic_tools(self):
        if os.path.exists(self.db_path):
            try:
                with open(self.db_path, "r", encoding="utf-8") as f:
                    self.dynamic_tools = json.load(f)
            except Exception:
                self.dynamic_tools = {}

    def processar(self, prompt: str):
        norm = prompt.lower().strip()
        
        # PRIORIDADE 1: Memoria Aprendida (se o prompt exato ja foi aprendido, usa-o)
        if norm in self.dynamic_tools:
            return self.dynamic_tools[norm], "APRENDIDO_NUVEM"

        # PRIORIDADE 2: Regras Hardcoded (Fallback)
        if "tetris" in norm:
            return self._gerar_tetris(), "LOCAL_ONNX_HARDCODED"
        if "cobra" in norm or "snake" in norm or "cobrinha" in norm:
            return self._gerar_snake(), "LOCAL_ONNX_HARDCODED"
        if "jogo da velha" in norm or "tic tac toe" in norm:
            if "placar" in norm or "historico" in norm or "histórico" in norm:
                return self._gerar_jogo_da_velha_premium(), "LOCAL_PREMIUM_ONISCIENTE"
            return self._gerar_jogo_da_velha(), "LOCAL_BASIC_HARDCODED"
        if ("roman" in norm or "romano" in norm or "romana" in norm) and "calculadora" in norm:
            return self._gerar_calculadora_romana(), "LOCAL_ONNX_HARDCODED"
        if "calculadora" in norm:
            return self._gerar_calculadora_cientifica(), "LOCAL_ONNX_HARDCODED"
        if "pomodoro" in norm or "temporizador" in norm or "timer" in norm:
            return self._gerar_pomodoro(), "LOCAL_ONNX_HARDCODED"
        if "tarefa" in norm or "todo" in norm or "to-do" in norm:
            return self._gerar_todo(), "LOCAL_ONNX_HARDCODED"
            
        return None, "NUVEM_NECESSARIA"

    def aprender_da_nuvem(self, prompt: str, html: str):
        norm = prompt.lower().strip()
        # O Quality Filter no app.py ja garantiu que esta versao e superior.
        # Agora guardamos na memoria.
        self.dynamic_tools[norm] = html
        print(f"[FUSAO] Novo conhecimento guardado: '{prompt[:30]}...'")
        try:
            with open(self.db_path, "w", encoding="utf-8") as f:
                json.dump(self.dynamic_tools, f, ensure_ascii=False, indent=2)
            print(f"[FUSAO] Novo conhecimento guardado: '{prompt[:20]}...'")
        except Exception as e:
            print(f"[FUSAO] Erro ao guardar: {e}")

    def _gerar_tetris(self):
        return """<div style='display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; font-family:sans-serif; color:#fff; background:#0f172a;'>
            <h2 style='color:#38bdf8; margin-bottom:10px;'>Tetris (ONNX Local)</h2>
            <div style='color:#94a3b8; margin-bottom:10px;'>Pontos: <span id='t-score' style='color:#10b981; font-weight:bold;'>0</span></div>
            <canvas id='tetrisCanvas' width='200' height='400' style='background:#1e293b; border-radius:8px; border: 2px solid #334155;'></canvas>
            <p style='color:#64748b; margin-top:10px; font-size:12px;'>Use as setas (Esq, Dir, Baixo) e Seta Cima para rodar</p>
            <button onclick='initTetris()' style='margin-top:10px; padding:8px 16px; background:#38bdf8; color:#000; border:none; border-radius:6px; font-weight:bold; cursor:pointer;'>Reiniciar</button>
            <script>
                const canvas = document.getElementById('tetrisCanvas');
                const ctx = canvas.getContext('2d');
                const COLS = 10, ROWS = 20, BLOCK = 20;
                let board = Array.from({length: ROWS}, () => Array(COLS).fill(0));
                let score = 0;
                let dropCounter = 0, dropInterval = 500, lastTime = 0;
                let piece = null;
                
                const PIECES = [
                    {shape: [[1,1,1,1]], color: '#38bdf8'},
                    {shape: [[1,1],[1,1]], color: '#f59e0b'},
                    {shape: [[0,1,0],[1,1,1]], color: '#a78bfa'},
                    {shape: [[1,0,0],[1,1,1]], color: '#3b82f6'},
                    {shape: [[0,0,1],[1,1,1]], color: '#f97316'},
                    {shape: [[0,1,1],[1,1,0]], color: '#10b981'},
                    {shape: [[1,1,0],[0,1,1]], color: '#ef4444'}
                ];

                function spawnPiece() {
                    const p = PIECES[Math.floor(Math.random() * PIECES.length)];
                    return { shape: p.shape, color: p.color, x: Math.floor((COLS - p.shape[0].length) / 2), y: 0 };
                }

                function collide() {
                    for(let y=0; y<piece.shape.length; y++) {
                        for(let x=0; x<piece.shape[y].length; x++) {
                            if(piece.shape[y][x] !== 0) {
                                let boardY = piece.y + y;
                                let boardX = piece.x + x;
                                if(boardY >= ROWS || boardX < 0 || boardX >= COLS || (boardY >= 0 && board[boardY][boardX] !== 0)) return true;
                            }
                        }
                    }
                    return false;
                }

                function merge() {
                    piece.shape.forEach((row, y) => {
                        row.forEach((value, x) => {
                            if(value !== 0 && piece.y + y >= 0) board[piece.y + y][piece.x + x] = piece.color;
                        });
                    });
                }

                function rotate() {
                    const oldShape = piece.shape;
                    const newShape = oldShape[0].map((_, i) => oldShape.map(row => row[i]).reverse());
                    piece.shape = newShape;
                    if(collide()) piece.shape = oldShape;
                }

                function clearLines() {
                    for(let y = ROWS - 1; y >= 0; y--) {
                        if(board[y].every(val => val !== 0)) {
                            board.splice(y, 1); board.unshift(Array(COLS).fill(0));
                            score += 100; document.getElementById('t-score').innerText = score; y++;
                        }
                    }
                }

                function drop() {
                    piece.y++;
                    if(collide()) {
                        piece.y--; merge(); clearLines(); piece = spawnPiece();
                        if(collide()) { alert('Game Over! Pontos: ' + score); initTetris(); }
                    }
                    dropCounter = 0;
                }

                function update(time = 0) {
                    const deltaTime = time - lastTime; lastTime = time; dropCounter += deltaTime;
                    if(dropCounter > dropInterval) drop();
                    draw(); requestAnimationFrame(update);
                }

                function draw() {
                    ctx.fillStyle = '#1e293b'; ctx.fillRect(0, 0, canvas.width, canvas.height);
                    board.forEach((row, y) => { row.forEach((color, x) => { if(color !== 0) { ctx.fillStyle = color; ctx.fillRect(x * BLOCK, y * BLOCK, BLOCK-1, BLOCK-1); } }); });
                    if(piece) { ctx.fillStyle = piece.color; piece.shape.forEach((row, y) => { row.forEach((value, x) => { if(value !== 0) ctx.fillRect((piece.x + x) * BLOCK, (piece.y + y) * BLOCK, BLOCK-1, BLOCK-1); }); }); }
                }

                document.addEventListener('keydown', e => {
                    if(!piece) return;
                    if(e.key === 'ArrowLeft') { piece.x--; if(collide()) piece.x++; }
                    if(e.key === 'ArrowRight') { piece.x++; if(collide()) piece.x--; }
                    if(e.key === 'ArrowDown') drop();
                    if(e.key === 'ArrowUp') rotate();
                });

                function initTetris() {
                    board = Array.from({length: ROWS}, () => Array(COLS).fill(0));
                    score = 0; dropInterval = 500; lastTime = 0; document.getElementById('t-score').innerText = score; piece = spawnPiece();
                }
                initTetris(); update();
            </script>
        </div>"""

    def _gerar_snake(self):
        return """<div style='display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; font-family:sans-serif; color:#fff; background:#0f172a;'>
            <h2 style='color:#10b981; margin-bottom:10px;'>Snake (ONNX Local)</h2>
