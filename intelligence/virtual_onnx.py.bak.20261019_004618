            <canvas id='snakeCanvas' width='300' height='300' style='background:#1e293b; border-radius:8px; box-shadow: 0 0 20px rgba(16,185,129,0.2);'></canvas>
            <div style='display:flex; gap:10px; margin-top:15px;'>
                <button id='startBtn' onclick='toggleStart()' style='padding:8px 20px; background:#10b981; color:#fff; border:none; border-radius:6px; font-weight:bold; cursor:pointer;'>Iniciar</button>
                <button onclick='resetSnake()' style='padding:8px 20px; background:#ef4444; color:#fff; border:none; border-radius:6px; font-weight:bold; cursor:pointer;'>Reiniciar</button>
            </div>
            <p style='color:#64748b; margin-top:10px; font-size:12px;'>Use as setas do teclado</p>
            <script>
                const canvas = document.getElementById('snakeCanvas'); const ctx = canvas.getContext('2d'); const grid = 15;
                let count = 0; let score = 0; let level = 1; let speed = 200; let isRunning = false; let gameLoop = null;
                let snake = { x: 150, y: 150, dx: grid, dy: 0, cells: [], maxCells: 4 }; let apple = { x: 45, y: 45 };
                function getRandomInt(min, max) { return Math.floor(Math.random() * (max - min)) + min; }
                function toggleStart() {
                    if (isRunning) { isRunning = false; document.getElementById('startBtn').innerText = 'Continuar'; document.getElementById('startBtn').style.background = '#f59e0b'; } 
                    else { isRunning = true; document.getElementById('startBtn').innerText = 'Pausar'; document.getElementById('startBtn').style.background = '#ef4444'; if(!gameLoop) gameLoop = setInterval(update, speed); }
                }
                function resetSnake() {
                    isRunning = false; if(gameLoop) { clearInterval(gameLoop); gameLoop = null; }
                    snake.x = 150; snake.y = 150; snake.cells = []; snake.maxCells = 4; snake.dx = grid; snake.dy = 0; score = 0; level = 1; speed = 200;
                    document.getElementById('score').innerText = score; document.getElementById('level').innerText = level;
                    document.getElementById('startBtn').innerText = 'Iniciar'; document.getElementById('startBtn').style.background = '#10b981';
                    apple.x = getRandomInt(0, 20) * grid; apple.y = getRandomInt(0, 20) * grid; draw();
                }
                document.addEventListener('keydown', function(e) {
                    if (!isRunning) return;
                    if (e.which === 37 && snake.dx === 0) { snake.dx = -grid; snake.dy = 0; }
                    else if (e.which === 38 && snake.dy === 0) { snake.dy = -grid; snake.dx = 0; }
                    else if (e.which === 39 && snake.dx === 0) { snake.dx = grid; snake.dy = 0; }
                    else if (e.which === 40 && snake.dy === 0) { snake.dy = -grid; snake.dx = 0; }
                });
                function draw() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    ctx.fillStyle = '#ef4444'; ctx.fillRect(apple.x, apple.y, grid-1, grid-1);
                    ctx.fillStyle = '#10b981'; snake.cells.forEach(function(cell) { ctx.fillRect(cell.x, cell.y, grid-1, grid-1); });
                }
                function update() {
                    if (!isRunning) return;
                    snake.x += snake.dx; snake.y += snake.dy;
                    if (snake.x < 0) snake.x = canvas.width - grid; else if (snake.x >= canvas.width) snake.x = 0;
                    if (snake.y < 0) snake.y = canvas.height - grid; else if (snake.y >= canvas.height) snake.y = 0;
                    snake.cells.unshift({ x: snake.x, y: snake.y }); if (snake.cells.length > snake.maxCells) snake.cells.pop();
                    snake.cells.forEach(function(cell, index) {
                        if (cell.x === apple.x && cell.y === apple.y) {
                            snake.maxCells++; score++; document.getElementById('score').innerText = score;
                            if (score % 5 === 0) { level++; document.getElementById('level').innerText = level; speed = Math.max(60, speed - 20); clearInterval(gameLoop); gameLoop = setInterval(update, speed); }
                            apple.x = getRandomInt(0, 20) * grid; apple.y = getRandomInt(0, 20) * grid;
                        }
                        for (let i = index + 1; i < snake.cells.length; i++) {
                            if (cell.x === snake.cells[i].x && cell.y === snake.cells[i].y) { isRunning = false; alert('Game Over! Pontos: ' + score); resetSnake(); }
                        }
                    });
                    draw();
                }
                resetSnake();
            </script>
        </div>"""

