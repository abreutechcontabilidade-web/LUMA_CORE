{
  "jogo_da_velha": {
    "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nbody { font-family: sans-serif; display: flex; flex-direction: column; align-items: center; }\nbody { background-color: #8b0000 !important; color: white; }</style>\n</head>\n<body>\n<h1>Jogo da Velha Base</h1>\n<div id=\"board\" style=\"display: grid; grid-template-columns: repeat(3, 50px); gap: 5px;\">\n    <div class=\"cell\"></div><div class=\"cell\"></div><div class=\"cell\"></div>\n</div>\n<script>\n// Logica basica aqui\n\nfunction tocarSom() { var audio = new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg'); audio.play(); }\n</script>\n<button onclick='tocarSom()' style='position:fixed; bottom:10px; right:10px;'>Tocar Som</button></body>\n</html>",
    "features": [
      "cor_vermelha",
      "som"
    ]
  },
  "calculadora": {
    "html": "<!DOCTYPE html><html><head><style>body{background:#1e293b;color:white;display:flex;justify-content:center;align-items:center;height:100vh;} .calc{background:#0f172a;padding:20px;border-radius:10px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}</style></head><body><div class=\"calc\"><input type=\"text\" style=\"grid-column:span 4;padding:10px;font-size:20px;\"><button>7</button><button>8</button><button>9</button><button>/</button><button>4</button><button>5</button><button>6</button><button>*</button><button>1</button><button>2</button><button>3</button><button>-</button><button>0</button><button>.</button><button>=</button><button>+</button></div></body></html>",
    "features": []
  },
  "o_que_e_dna": {
    "html": "<!DOCTYPE html><html><head><style>body{background:#1e293b;color:white;text-align:center;}</style></head><body><h1>App Gerado Localmente</h1><p>Prompt: o que e DNA</p></body></html>",
    "features": [
      "autopoiese_evoluida"
    ]
  },
  "criar_jogo_da_cobra_": {
    "html": "<!--\n  Snake Game\n  Author:     Ramazan Çetinkaya (https://github.com/ramazancetinkaya)\n  Repository: https://github.com/ramazancetinkaya/snake-game\n  License:    MIT License\n-->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n  <meta name=\"description\" content=\"A modern, responsive, and smooth Snake game built with vanilla web technologies.\">\n  <title>Snake Game</title>\n  <!-- FontAwesome 6 (Cloudflare CDN) -->\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\n  <!-- Custom CSS -->\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <!-- Orientation Lock Screen (Mobile Landscape Blocker) -->\n  <div id=\"orientation-blocker\" class=\"orientation-blocker\" aria-hidden=\"true\">\n    <div class=\"orientation-blocker-content\">\n      <div class=\"orientation-icon\">\n        <i class=\"fa-solid fa-mobile-screen-button\"></i>\n      </div>\n      <h2>Rotate Your Device</h2>\n      <p>Snake on mobile phones is exclusively supported in portrait mode. Please rotate your phone to continue playing.</p>\n    </div>\n  </div>\n\n  <!-- Main App Layout -->\n  <div class=\"app-container\">\n    <!-- Header -->\n    <header class=\"app-header\">\n      <div class=\"brand\">\n        <h1 class=\"brand-title\">SNAKE</h1>\n        <span class=\"brand-badge\">PRO</span>\n      </div>\n\n      <div class=\"header-actions\">\n        <button id=\"btn-header-help\" class=\"btn-icon\" aria-label=\"How to Play\" title=\"How to Play (H)\">\n          <i class=\"fa-solid fa-circle-question\"></i>\n        </button>\n        <button id=\"btn-header-achievements\" class=\"btn-icon\" aria-label=\"Achievements\" title=\"Achievements (T)\">\n          <i class=\"fa-solid fa-trophy\"></i>\n          <span id=\"badge-achievements-count\" class=\"icon-sub-badge\" style=\"display: none;\">0</span>\n        </button>\n        <button id=\"btn-header-pause\" class=\"btn-icon\" aria-label=\"Pause Game\" title=\"Pause Game (Space / P)\">\n          <i class=\"fa-solid fa-pause\"></i>\n        </button>\n        <button id=\"btn-header-restart\" class=\"btn-icon\" aria-label=\"Restart Game\" title=\"Restart Game (R)\">\n          <i class=\"fa-solid fa-rotate-right\"></i>\n        </button>\n        <button id=\"btn-header-settings\" class=\"btn-icon\" aria-label=\"Settings\" title=\"Settings (O)\">\n          <i class=\"fa-solid fa-gear\"></i>\n        </button>\n      </div>\n    </header>\n\n    <!-- Main Workspace -->\n    <main class=\"game-layout\">\n      <!-- Game Board Container -->\n      <section class=\"board-column\">\n        <!-- Live Quick Stats (Mobile / Tablet Bar) -->\n        <div class=\"mobile-stats-bar\">\n          <div class=\"mini-stat\">\n            <span class=\"mini-label\">SCORE</span>\n            <span id=\"mobile-score-val\" class=\"mini-value\">0</span>\n          </div>\n          <div class=\"mini-stat\">\n            <span class=\"mini-label\">BEST</span>\n            <span id=\"mobile-best-val\" class=\"mini-value\">0</span>\n          </div>\n          <div class=\"mini-stat\">\n            <span class=\"mini-label\">SPEED</span>\n            <span id=\"mobile-speed-val\" class=\"mini-value badge-speed\">Normal</span>\n          </div>\n          <div class=\"mini-stat\" id=\"mobile-combo-stat\" style=\"display: none;\">\n            <span class=\"mini-label\">COMBO</span>\n            <span id=\"mobile-combo-val\" class=\"mini-value text-accent\">x2</span>\n          </div>\n        </div>\n\n        <!-- The Snake Board Wrapper -->\n        <div class=\"board-frame\">\n          <div id=\"game-board\" class=\"game-board\" role=\"region\" aria-label=\"Snake Play Area\">\n            <!-- Snake segments and food items injected by JavaScript -->\n          </div>\n\n          <!-- Countdown Overlay (3, 2, 1, GO!) -->\n          <div id=\"countdown-overlay\" class=\"countdown-overlay\" aria-live=\"polite\">\n            <div id=\"countdown-number\" class=\"countdown-number\">3</div>\n            <div class=\"countdown-label\">GET READY!</div>\n          </div>\n\n          <!-- In-Board Pause Overlay (Borderless Optical Blur, Non-Modal) -->\n          <div id=\"pause-overlay\" class=\"pause-overlay\" style=\"display: none;\" aria-live=\"polite\">\n            <div class=\"inboard-pause-wrap\">\n              <div class=\"inboard-pause-icon\">\n                <i class=\"fa-solid fa-pause\"></i>\n              </div>\n              <h2 class=\"inboard-pause-title\">PAUSED</h2>\n              <p class=\"inboard-pause-hint web-only-hint\">Press <kbd>Space</kbd> or click anywhere to resume</p>\n              <p class=\"inboard-pause-hint touch-only-hint\">Tap anywhere to resume</p>\n            </div>\n          </div>\n\n          <!-- Active Powerup / Bonus Pill Banner -->\n          <div id=\"active-buff-banner\" class=\"buff-banner\" style=\"display: none;\">\n            <i class=\"fa-solid fa-bolt\"></i>\n            <span id=\"buff-banner-text\">Chill Mode: 5s</span>\n          </div>\n        </div>\n\n        <!-- Desktop Shortcuts Reference Bar (Sleek single-line strip, Web Only) -->\n        <div class=\"board-shortcuts-bar web-only-shortcuts\" aria-label=\"Quick Keyboard Hotkeys\">\n          <span class=\"shortcut-tag\"><kbd>W A S D</kbd> Steer</span>\n          <span class=\"shortcut-tag\"><kbd>Space / P</kbd> Pause</span>\n          <span class=\"shortcut-tag\"><kbd>R</kbd> Restart</span>\n          <span class=\"shortcut-tag\"><kbd>M</kbd> Mute</span>\n          <span class=\"shortcut-tag\"><kbd>T</kbd> Trophies</span>\n          <span class=\"shortcut-tag\"><kbd>O</kbd> Settings</span>\n          <span class=\"shortcut-tag\"><kbd>H</kbd> Guide</span>\n        </div>\n\n        <!-- Touch Controls for Mobile & Tablet -->\n        <div id=\"touch-controls\" class=\"touch-controls\" aria-label=\"Touch Directional Controls\">\n          <div class=\"dpad-grid\">\n            <div class=\"dpad-cell cell-empty\"></div>\n            <button id=\"touch-up\" class=\"dpad-btn dpad-up\" aria-label=\"Move Up\">\n              <i class=\"fa-solid fa-chevron-up\"></i>\n            </button>\n            <div class=\"dpad-cell cell-empty\"></div>\n\n            <button id=\"touch-left\" class=\"dpad-btn dpad-left\" aria-label=\"Move Left\">\n              <i class=\"fa-solid fa-chevron-left\"></i>\n            </button>\n            <button id=\"touch-center-pause\" class=\"dpad-btn dpad-center\" aria-label=\"Pause / Resume\">\n              <i id=\"touch-center-icon\" class=\"fa-solid fa-pause\"></i>\n            </button>\n            <button id=\"touch-right\" class=\"dpad-btn dpad-right\" aria-label=\"Move Right\">\n              <i class=\"fa-solid fa-chevron-right\"></i>\n            </button>\n\n            <div class=\"dpad-cell cell-empty\"></div>\n            <button id=\"touch-down\" class=\"dpad-btn dpad-down\" aria-label=\"Move Down\">\n              <i class=\"fa-solid fa-chevron-down\"></i>\n            </button>\n            <div class=\"dpad-cell cell-empty\"></div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Sidebar (Desktop & Tablet Landscape) -->\n      <aside class=\"sidebar-column\">\n        <!-- Score Card -->\n        <div class=\"card stat-card\">\n          <div class=\"card-header\">\n            <span class=\"card-title\">SCORE BOARD</span>\n            <span id=\"current-speed-tag\" class=\"speed-pill\">Normal</span>\n          </div>\n          <div class=\"score-display\">\n            <div class=\"score-item primary-score\">\n              <span class=\"score-label\">Current Score</span>\n              <span id=\"sidebar-score\" class=\"score-number\">0</span>\n            </div>\n            <div class=\"score-divider\"></div>\n            <div class=\"score-item secondary-score\">\n              <span class=\"score-label\">Best Record</span>\n              <span id=\"sidebar-best\" class=\"score-number\">0</span>\n            </div>\n          </div>\n\n          <!-- Combo Bar -->\n          <div id=\"combo-container\" class=\"combo-wrapper\" style=\"opacity: 0.4;\">\n            <div class=\"combo-header\">\n              <span class=\"combo-title\"><i class=\"fa-solid fa-fire text-amber\"></i> Combo Streak</span>\n              <span id=\"combo-multiplier\" class=\"combo-badge\">1x</span>\n            </div>\n            <div class=\"combo-meter\">\n              <div id=\"combo-progress\" class=\"combo-fill\" style=\"width: 0%;\"></div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Real-Time Run Stats -->\n        <div class=\"card metrics-card\">\n          <span class=\"card-title\">SESSION STATS</span>\n          <div class=\"metrics-grid\">\n            <div class=\"metric-item\">\n              <i class=\"fa-solid fa-ruler-combined metric-icon\"></i>\n              <div class=\"metric-details\">\n                <span class=\"metric-val\" id=\"stat-length\">3</span>\n                <span class=\"metric-name\">Snake Length</span>\n              </div>\n            </div>\n            <div class=\"metric-item\">\n              <i class=\"fa-solid fa-apple-whole metric-icon text-crimson\"></i>\n              <div class=\"metric-details\">\n                <span class=\"metric-val\" id=\"stat-apples\">0</span>\n                <span class=\"metric-name\">Apples Eaten</span>\n              </div>\n            </div>\n            <div class=\"metric-item\">\n              <i class=\"fa-solid fa-stopwatch metric-icon\"></i>\n              <div class=\"metric-details\">\n                <span class=\"metric-val\" id=\"stat-time\">00:00</span>\n                <span class=\"metric-name\">Duration</span>\n              </div>\n            </div>\n            <div class=\"metric-item\">\n              <i class=\"fa-solid fa-gauge-high metric-icon\"></i>\n              <div class=\"metric-details\">\n                <span class=\"metric-val\" id=\"stat-speed-ms\">115ms</span>\n                <span class=\"metric-name\">Tick Rate</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Quick Actions Card (Achievements & Guide) -->\n        <div class=\"card quick-actions-card\">\n          <div class=\"quick-action-row\" id=\"row-sidebar-achievements\" role=\"button\" tabindex=\"0\" aria-label=\"Open Achievements\">\n            <div class=\"quick-action-info\">\n              <span class=\"quick-action-title\"><i class=\"fa-solid fa-trophy text-amber\"></i> Achievements</span>\n              <span class=\"quick-action-subtitle\">15 Tiered Challenges</span>\n            </div>\n            <span id=\"sidebar-achievements-val\" class=\"stat-badge\">0 / 15</span>\n          </div>\n          <div class=\"quick-action-divider\"></div>\n          <div class=\"quick-action-row\" id=\"row-sidebar-help\" role=\"button\" tabindex=\"0\" aria-label=\"Open How to Play\">\n            <div class=\"quick-action-info\">\n              <span class=\"quick-action-title\"><i class=\"fa-solid fa-circle-question text-muted\"></i> How to Play</span>\n              <span class=\"quick-action-subtitle\">Rules, Foods & Multipliers</span>\n            </div>\n            <i class=\"fa-solid fa-chevron-right text-muted action-arrow\"></i>\n          </div>\n        </div>\n      </aside>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"app-footer\">\n      <p>Developed by <a href=\"https://github.com/ramazancetinkaya\" target=\"_blank\" rel=\"noopener noreferrer\">Ramazan Çetinkaya</a></p>\n    </footer>\n  </div>\n\n  <!-- Dedicated Modal Backdrop Layer (Completely Isolated from Game Board) -->\n  <div id=\"modal-overlay\" class=\"modal-overlay\" aria-hidden=\"true\">\n    <div class=\"modal-backdrop\"></div>\n    <!-- Ambient Wandering Snake Background Canvas (Only active on Start Screen) -->\n    <canvas id=\"start-ambient-canvas\" class=\"ambient-canvas\"></canvas>\n\n    <!-- START GAME MODAL (Redesigned with Hero Branding & Ambient Feel) -->\n    <div id=\"modal-start\" class=\"modal-window modal-window-start\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"start-modal-title\">\n      <div class=\"modal-card modal-scrollable\">\n        <div class=\"start-hero-header\">\n          <div class=\"start-brand-pill\">\n            <span class=\"start-brand-title\">SNAKE</span>\n            <span class=\"start-brand-badge\">PRO</span>\n          </div>\n          <h2 id=\"start-modal-title\" class=\"start-hero-heading\">Welcome to the Arena</h2>\n          <p class=\"start-hero-subtitle\">Classic mechanics reimagined with fluid movement, power-ups and 15 tiered achievements.</p>\n\n          <!-- Quick Stats Ribbon -->\n          <div class=\"start-stats-ribbon\">\n            <div class=\"ribbon-item\">\n              <i class=\"fa-solid fa-trophy text-amber\"></i>\n              <span>Best: <strong id=\"start-stat-best\">0</strong></span>\n            </div>\n            <div class=\"ribbon-divider\"></div>\n            <div class=\"ribbon-item\">\n              <i class=\"fa-solid fa-apple-whole text-crimson\"></i>\n              <span>Apples: <strong id=\"start-stat-apples\">0</strong></span>\n            </div>\n            <div class=\"ribbon-divider\"></div>\n            <div class=\"ribbon-item\">\n              <i class=\"fa-solid fa-medal text-emerald\"></i>\n              <span>Badges: <strong id=\"start-stat-badges\">0/15</strong></span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"modal-body\">\n          <!-- Game Speed Selection Cards -->\n          <div class=\"form-group\">\n            <div class=\"form-label-row\">\n              <label class=\"form-label\">Choose Game Speed</label>\n              <span class=\"form-hint\">Adjustable in Settings</span>\n            </div>\n            <div class=\"start-speed-cards\" role=\"radiogroup\" aria-label=\"Game Speed\">\n              <button type=\"button\" class=\"start-speed-card\" data-speed=\"relax\" role=\"radio\" aria-checked=\"false\">\n                <div class=\"speed-card-top\">\n                  <span class=\"speed-card-name\">Relax</span>\n                  <span class=\"speed-card-tag\">160ms</span>\n                </div>\n                <p class=\"speed-card-desc\">Calm, forgiving pace for relaxed play & strategy.</p>\n              </button>\n              <button type=\"button\" class=\"start-speed-card active\" data-speed=\"normal\" role=\"radio\" aria-checked=\"true\">\n                <div class=\"speed-card-top\">\n                  <span class=\"speed-card-name\">Normal</span>\n                  <span class=\"speed-card-tag badge-recommended\">Classic</span>\n                </div>\n                <p class=\"speed-card-desc\">The authentic arcade standard. Crisp & balanced.</p>\n              </button>\n              <button type=\"button\" class=\"start-speed-card\" data-speed=\"fast\" role=\"radio\" aria-checked=\"false\">\n                <div class=\"speed-card-top\">\n                  <span class=\"speed-card-name\">Fast</span>\n                  <span class=\"speed-card-tag badge-hot\">80ms • +20% Pts</span>\n                </div>\n                <p class=\"speed-card-desc\">High adrenaline, swift reactions & higher rewards.</p>\n              </button>\n              <button type=\"button\" class=\"start-speed-card\" data-speed=\"dynamic\" role=\"radio\" aria-checked=\"false\">\n                <div class=\"speed-card-top\">\n                  <span class=\"speed-card-name\">Dynamic</span>\n                  <span class=\"speed-card-tag badge-adaptive\">Adaptive</span>\n                </div>\n                <p class=\"speed-card-desc\">Pace smoothly accelerates as your snake grows longer.</p>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"modal-footer flex-column\">\n          <button id=\"btn-start-game\" class=\"btn btn-primary btn-block btn-lg\">\n            <span>Start Game</span>\n            <i class=\"fa-solid fa-arrow-right\"></i>\n          </button>\n          <div class=\"start-secondary-links\">\n            <button type=\"button\" id=\"btn-start-open-help\" class=\"text-link-btn\">\n              <i class=\"fa-solid fa-circle-question\"></i> How to Play & Rules\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n\n\n    <!-- GAME OVER MODAL (Run Terminated) -->\n    <div id=\"modal-gameover\" class=\"modal-window modal-window-gameover\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"gameover-modal-title\">\n      <div class=\"modal-card modal-scrollable\">\n        <div class=\"modal-header text-center\">\n          <span class=\"badge-danger\">\n            <i class=\"fa-solid fa-triangle-exclamation\"></i>\n            <span>RUN TERMINATED</span>\n          </span>\n          <h2 id=\"gameover-modal-title\" class=\"modal-title\">Game Over</h2>\n          <p id=\"gameover-cause\" class=\"modal-subtitle\">You hit the wall!</p>\n        </div>\n\n        <div class=\"modal-body\">\n          <div id=\"new-record-banner\" class=\"new-record-banner\" style=\"display: none;\">\n            <i class=\"fa-solid fa-trophy\"></i>\n            <span>NEW PERSONAL RECORD!</span>\n          </div>\n\n          <div class=\"gameover-hero-score\">\n            <span class=\"hero-score-label\">FINAL SCORE</span>\n            <span id=\"gameover-score\" class=\"hero-score-val\">0</span>\n            <span class=\"hero-score-unit\">POINTS</span>\n          </div>\n\n          <div class=\"gameover-stats-grid\">\n            <div class=\"result-tile\">\n              <span class=\"tile-icon\"><i class=\"fa-solid fa-trophy text-amber\"></i></span>\n              <span class=\"tile-label\">Best</span>\n              <span id=\"gameover-best\" class=\"tile-number\">0</span>\n            </div>\n            <div class=\"result-tile\">\n              <span class=\"tile-icon\"><i class=\"fa-solid fa-apple-whole text-crimson\"></i></span>\n              <span class=\"tile-label\">Apples</span>\n              <span id=\"gameover-apples\" class=\"tile-number\">0</span>\n            </div>\n            <div class=\"result-tile\">\n              <span class=\"tile-icon\"><i class=\"fa-solid fa-bolt text-amber\"></i></span>\n              <span class=\"tile-label\">Combo</span>\n              <span id=\"gameover-combo\" class=\"tile-number\">x1</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"modal-footer flex-column\">\n          <button id=\"btn-gameover-retry\" class=\"btn btn-primary btn-block btn-lg\">\n            <i class=\"fa-solid fa-rotate-right\"></i>\n            <span>Play Again</span>\n            <kbd class=\"btn-kbd web-only-shortcuts\">Space / Enter</kbd>\n          </button>\n          <button id=\"btn-gameover-menu\" class=\"btn btn-secondary btn-block\">\n            <i class=\"fa-solid fa-house\"></i>\n            <span>Main Menu</span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- SETTINGS MODAL (Ultra-Premium Native Studio Design) -->\n    <div id=\"modal-settings\" class=\"modal-window modal-window-settings\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"settings-modal-title\">\n      <div class=\"modal-card modal-scrollable\">\n        <div class=\"modal-header\">\n          <div class=\"modal-title-wrap\">\n            <h2 id=\"settings-modal-title\" class=\"modal-title\">Preferences</h2>\n            <p class=\"modal-subtitle\">Theme styling, speed, boundaries & grid dimensions.</p>\n          </div>\n          <button id=\"btn-close-settings\" class=\"btn-icon\" aria-label=\"Close Settings\">\n            <i class=\"fa-solid fa-xmark\"></i>\n          </button>\n        </div>\n\n        <div class=\"modal-body\">\n          <!-- Active Warning -->\n          <div id=\"settings-reset-warning\" class=\"notice-box\" style=\"display: none;\">\n            <i class=\"fa-solid fa-circle-exclamation\"></i>\n            <span>Changing gameplay options during an active run will reset the current session.</span>\n          </div>\n\n          <!-- Live Interactive Snake Preview Card -->\n          <div class=\"settings-preview-card\">\n            <div class=\"preview-header-row\">\n              <span class=\"preview-label\">LIVE SNAKE PREVIEW</span>\n              <span id=\"preview-skin-title\" class=\"preview-skin-title\">Obsidian Slate</span>\n            </div>\n            <div class=\"preview-snake-track\">\n              <div id=\"preview-snake-tail\" class=\"preview-segment preview-tail\"></div>\n              <div id=\"preview-snake-body-2\" class=\"preview-segment preview-body\"></div>\n              <div id=\"preview-snake-body-1\" class=\"preview-segment preview-body\"></div>\n              <div id=\"preview-snake-head\" class=\"preview-segment preview-head\">\n                <div class=\"preview-eyes\">\n                  <div class=\"preview-eye preview-eye-1\"></div>\n                  <div class=\"preview-eye preview-eye-2\"></div>\n                </div>\n                <div class=\"preview-tongue\"></div>\n              </div>\n              <div class=\"preview-target-apple\" title=\"Delicious Apple\">\n                <div class=\"mini-apple-leaf\"></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Snake Skin Selector Row -->\n          <div class=\"settings-group\">\n            <span class=\"settings-group-label\">Color Themes</span>\n            <div class=\"skin-selector-grid\" role=\"radiogroup\" aria-label=\"Snake Skin Color\">\n              <button type=\"button\" class=\"skin-swatch-card active\" data-skin=\"obsidian\" title=\"Obsidian Slate\">\n                <span class=\"swatch-disc\" style=\"background: linear-gradient(135deg, #1e293b, #334155);\"></span>\n                <span class=\"swatch-label\">Obsidian</span>\n                <span class=\"swatch-check\"><i class=\"fa-solid fa-check\"></i></span>\n              </button>\n              <button type=\"button\" class=\"skin-swatch-card\" data-skin=\"emerald\" title=\"Emerald Viper\">\n                <span class=\"swatch-disc\" style=\"background: linear-gradient(135deg, #065f46, #059669);\"></span>\n                <span class=\"swatch-label\">Emerald</span>\n                <span class=\"swatch-check\"><i class=\"fa-solid fa-check\"></i></span>\n              </button>\n              <button type=\"button\" class=\"skin-swatch-card\" data-skin=\"cobalt\" title=\"Cobalt Navy\">\n                <span class=\"swatch-disc\" style=\"background: linear-gradient(135deg, #1e3a8a, #2563eb);\"></span>\n                <span class=\"swatch-label\">Cobalt</span>\n                <span class=\"swatch-check\"><i class=\"fa-solid fa-check\"></i></span>\n              </button>\n              <button type=\"button\" class=\"skin-swatch-card\" data-skin=\"amber\" title=\"Amber Coral\">\n                <span class=\"swatch-disc\" style=\"background: linear-gradient(135deg, #92400e, #d97706);\"></span>\n                <span class=\"swatch-label\">Amber</span>\n                <span class=\"swatch-check\"><i class=\"fa-solid fa-check\"></i></span>\n              </button>\n              <button type=\"button\" class=\"skin-swatch-card\" data-skin=\"crimson\" title=\"Crimson Ruby\">\n                <span class=\"swatch-disc\" style=\"background: linear-gradient(135deg, #881337, #be123c);\"></span>\n                <span class=\"swatch-label\">Ruby</span>\n                <span class=\"swatch-check\"><i class=\"fa-solid fa-check\"></i></span>\n              </button>\n              <button type=\"button\" class=\"skin-swatch-card\" data-skin=\"sage\" title=\"Sage Olive\">\n                <span class=\"swatch-disc\" style=\"background: linear-gradient(135deg, #365314, #65a30d);\"></span>\n                <span class=\"swatch-label\">Sage</span>\n                <span class=\"swatch-check\"><i class=\"fa-solid fa-check\"></i></span>\n              </button>\n            </div>\n          </div>\n\n          <!-- Grouped Settings Rows (iOS/macOS Studio Layout) -->\n          <div class=\"settings-group\">\n            <span class=\"settings-group-label\">Gameplay Rules</span>\n            <div class=\"settings-card-stack\">\n              <!-- Row: Sound Effects -->\n              <div class=\"settings-row\">\n                <div class=\"settings-row-info\">\n                  <div class=\"settings-row-icon\"><i id=\"settings-sound-icon\" class=\"fa-solid fa-volume-high\"></i></div>\n                  <div class=\"settings-row-text\">\n                    <span class=\"settings-row-title\">Sound Effects</span>\n                    <span class=\"settings-row-desc\">Audio cues, chimes & alerts</span>\n                  </div>\n                </div>\n                <div class=\"segmented-control\" role=\"radiogroup\" aria-label=\"Sound Effects\">\n                  <button type=\"button\" id=\"sound-mode-on\" class=\"segment-btn active\" data-sound=\"on\">\n                    <i class=\"fa-solid fa-volume-high\"></i> On\n                  </button>\n                  <button type=\"button\" id=\"sound-mode-off\" class=\"segment-btn\" data-sound=\"off\">\n                    <i class=\"fa-solid fa-volume-xmark\"></i> Muted\n                  </button>\n                </div>\n              </div>\n\n              <!-- Row: Speed -->\n              <div class=\"settings-row\">\n                <div class=\"settings-row-info\">\n                  <div class=\"settings-row-icon\"><i class=\"fa-solid fa-gauge-high\"></i></div>\n                  <div class=\"settings-row-text\">\n                    <span class=\"settings-row-title\">Game Speed</span>\n                    <span class=\"settings-row-desc\">Tick interval rate</span>\n                  </div>\n                </div>\n                <div class=\"segmented-control\" role=\"radiogroup\">\n                  <button type=\"button\" class=\"segment-btn\" data-settings-speed=\"relax\">Relax</button>\n                  <button type=\"button\" class=\"segment-btn active\" data-settings-speed=\"normal\">Normal</button>\n                  <button type=\"button\" class=\"segment-btn\" data-settings-speed=\"fast\">Fast</button>\n                  <button type=\"button\" class=\"segment-btn\" data-settings-speed=\"dynamic\">Dynamic</button>\n                </div>\n              </div>\n\n              <!-- Row: Boundaries -->\n              <div class=\"settings-row\">\n                <div class=\"settings-row-info\">\n                  <div class=\"settings-row-icon\"><i class=\"fa-solid fa-border-all\"></i></div>\n                  <div class=\"settings-row-text\">\n                    <span class=\"settings-row-title\">Board Boundaries</span>\n                    <span class=\"settings-row-desc\">Wall collision vs portal wrap</span>\n                  </div>\n                </div>\n                <div class=\"segmented-control\" role=\"radiogroup\">\n                  <button type=\"button\" id=\"wall-mode-solid\" class=\"segment-btn active\" data-wall=\"solid\">\n                    Solid Walls\n                  </button>\n                  <button type=\"button\" id=\"wall-mode-wrap\" class=\"segment-btn\" data-wall=\"wrap\">\n                    Portal Wrap\n                  </button>\n                </div>\n              </div>\n\n              <!-- Row: Grid Dimensions -->\n              <div class=\"settings-row\">\n                <div class=\"settings-row-info\">\n                  <div class=\"settings-row-icon\"><i class=\"fa-solid fa-table-cells\"></i></div>\n                  <div class=\"settings-row-text\">\n                    <span class=\"settings-row-title\">Grid Dimensions</span>\n                    <span class=\"settings-row-desc\">Playfield units</span>\n                  </div>\n                </div>\n                <div class=\"segmented-control\" role=\"radiogroup\">\n                  <button type=\"button\" id=\"grid-size-20\" class=\"segment-btn active\" data-grid=\"20\">\n                    Standard (20 × 20)\n                  </button>\n                  <button type=\"button\" id=\"grid-size-24\" class=\"segment-btn\" data-grid=\"24\">\n                    Spacious (24 × 24)\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Danger Section -->\n          <div class=\"settings-danger-card\">\n            <div class=\"danger-info\">\n              <span class=\"danger-title\">Erase All Data</span>\n              <span class=\"danger-desc\">Reset high scores, stats and unlocked achievements.</span>\n            </div>\n            <button type=\"button\" id=\"btn-reset-storage\" class=\"btn btn-danger-subtle btn-sm\">\n              <i class=\"fa-solid fa-trash-can\"></i>\n              <span>Clear Data</span>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"modal-footer flex-row-buttons\">\n          <button type=\"button\" id=\"btn-cancel-settings\" class=\"btn btn-secondary flex-1\">\n            <span>Cancel</span>\n          </button>\n          <button type=\"button\" id=\"btn-save-settings\" class=\"btn btn-primary flex-2\">\n            <i class=\"fa-solid fa-check\"></i>\n            <span>Save & Apply</span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- HOW TO PLAY MODAL (Dedicated Interactive Guide) -->\n    <div id=\"modal-help\" class=\"modal-window modal-window-help\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"modal-card modal-scrollable\">\n        <div class=\"modal-header\">\n          <div class=\"modal-title-wrap\">\n            <h2 id=\"help-modal-title\" class=\"modal-title\">How to Play</h2>\n            <p class=\"modal-subtitle\">Rules, steering controls, food varieties & scoring mechanics.</p>\n          </div>\n          <button id=\"btn-close-help\" class=\"btn-icon\" aria-label=\"Close Guide\">\n            <i class=\"fa-solid fa-xmark\"></i>\n          </button>\n        </div>\n\n        <div class=\"modal-body\">\n          <!-- Guide Navigation Tabs -->\n          <div class=\"help-tabs-bar\">\n            <button type=\"button\" class=\"help-tab active\" data-help-tab=\"controls\">\n              <i class=\"fa-solid fa-keyboard\"></i> Controls\n            </button>\n            <button type=\"button\" class=\"help-tab\" data-help-tab=\"foods\">\n              <i class=\"fa-solid fa-apple-whole\"></i> Foods & Items\n            </button>\n            <button type=\"button\" class=\"help-tab\" data-help-tab=\"mechanics\">\n              <i class=\"fa-solid fa-fire\"></i> Combos & Rules\n            </button>\n          </div>\n\n          <!-- Guide Tab Contents -->\n          <div class=\"help-content-area\">\n            <!-- Tab 1: Controls -->\n            <div id=\"help-pane-controls\" class=\"help-pane active\">\n              <div class=\"help-guide-card web-only-shortcuts\">\n                <span class=\"help-card-title\">Desktop & Laptop Keyboard</span>\n                <div class=\"help-keys-grid\">\n                  <div class=\"help-key-item\">\n                    <span class=\"key-badge-wrap\"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or <kbd>Arrow Keys</kbd></span>\n                    <span class=\"key-desc\">Turn snake smoothly in 4 directions</span>\n                  </div>\n                  <div class=\"help-key-item\">\n                    <span class=\"key-badge-wrap\"><kbd>Space</kbd> or <kbd>P</kbd></span>\n                    <span class=\"key-desc\">Instant pause or resume game</span>\n                  </div>\n                  <div class=\"help-key-item\">\n                    <span class=\"key-badge-wrap\"><kbd>R</kbd></span>\n                    <span class=\"key-desc\">Quick restart run</span>\n                  </div>\n                  <div class=\"help-key-item\">\n                    <span class=\"key-badge-wrap\"><kbd>M</kbd></span>\n                    <span class=\"key-desc\">Toggle sound effects on or off</span>\n                  </div>\n                  <div class=\"help-key-item\">\n                    <span class=\"key-badge-wrap\"><kbd>T</kbd> / <kbd>O</kbd> / <kbd>H</kbd></span>\n                    <span class=\"key-desc\">Open Achievements (T), Settings (O), or Guide (H)</span>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"help-guide-card\">\n                <span class=\"help-card-title\">Mobile & Tablet Controls</span>\n                <div class=\"help-touch-explainer\">\n                  <div class=\"touch-method-item\">\n                    <div class=\"method-icon\"><i class=\"fa-solid fa-gamepad\"></i></div>\n                    <div>\n                      <strong>On-Screen D-Pad</strong>\n                      <p>Tap Up, Down, Left, Right chevrons. Center circle pauses.</p>\n                    </div>\n                  </div>\n                  <div class=\"touch-method-item\">\n                    <div class=\"method-icon\"><i class=\"fa-solid fa-hand-pointer\"></i></div>\n                    <div>\n                      <strong>Swipe Anywhere on Board</strong>\n                      <p>Flick your finger across the playfield to steer seamlessly.</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- Tab 2: Foods & Power-Ups -->\n            <div id=\"help-pane-foods\" class=\"help-pane\">\n              <div class=\"food-explainer-list\">\n                <!-- 1. Classic Apple -->\n                <div class=\"food-explainer-item\">\n                  <div class=\"food-preview-disc apple-disc\">\n                    <div class=\"mini-apple-leaf\"></div>\n                  </div>\n                  <div class=\"food-explainer-info\">\n                    <div class=\"food-name-row\">\n                      <strong>Classic Apple</strong>\n                      <span class=\"food-badge-base\">+10 Pts × Combo</span>\n                    </div>\n                    <p>Always on the board. Each apple increases your snake's length by 1 segment and charges your combo streak.</p>\n                  </div>\n                </div>\n\n                <!-- 2. Golden Star Fruit -->\n                <div class=\"food-explainer-item\">\n                  <div class=\"food-preview-disc star-disc\">\n                    <i class=\"fa-solid fa-star\"></i>\n                  </div>\n                  <div class=\"food-explainer-info\">\n                    <div class=\"food-name-row\">\n                      <strong>Golden Star Fruit</strong>\n                      <span class=\"food-badge-bonus\">+35 Pts • +2.0s Combo</span>\n                    </div>\n                    <p>Spawns periodically for 8 seconds. Awards massive points and instantly extends your active combo window!</p>\n                  </div>\n                </div>\n\n                <!-- 3. Chill Berry -->\n                <div class=\"food-explainer-item\">\n                  <div class=\"food-preview-disc berry-disc\">\n                    <i class=\"fa-solid fa-snowflake\"></i>\n                  </div>\n                  <div class=\"food-explainer-info\">\n                    <div class=\"food-name-row\">\n                      <strong>Chill Berry</strong>\n                      <span class=\"food-badge-chill\">+20 Pts • Pace Slowed 6s</span>\n                    </div>\n                    <p>Rare ice blue fruit. Reduces frantic movement speed by 25% for 6 seconds, granting easy maneuvering in tight spaces.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- Tab 3: Combos & Rules -->\n            <div id=\"help-pane-mechanics\" class=\"help-pane\">\n              <div class=\"help-guide-card\">\n                <span class=\"help-card-title\"><i class=\"fa-solid fa-fire text-amber\"></i> Combo Streak Multiplier</span>\n                <p class=\"help-text-para\">\n                  Eating another food item before your combo bar drains levels up your multiplier from <strong>x1</strong> up to <strong>x5</strong>! \n                  At x5, every food item awards quintuple points, propelling your score to record levels.\n                </p>\n              </div>\n\n              <div class=\"help-guide-card\">\n                <span class=\"help-card-title\">Game Modes & Speeds</span>\n                <ul class=\"help-bullet-list\">\n                  <li><strong>Relax (160ms):</strong> Generous 5.5s combo timer. Perfect for casual, peaceful play.</li>\n                  <li><strong>Normal (115ms):</strong> Balanced 4.5s combo timer. Classic authentic arcade experience.</li>\n                  <li><strong>Fast (80ms):</strong> 3.8s combo timer with higher base points (+20% bonus) for reflex masters.</li>\n                  <li><strong>Dynamic:</strong> Begins at comfortable 135ms and accelerates down to 60ms as your snake grows.</li>\n                </ul>\n              </div>\n\n              <div class=\"help-guide-card\">\n                <span class=\"help-card-title\">Boundaries (Wall Modes)</span>\n                <p class=\"help-text-para\">\n                  • <strong>Solid Walls:</strong> Crashing into the border ends the run.<br>\n                  • <strong>Portal Wrap:</strong> Slithering into an edge warps your snake through to the opposite side!\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button id=\"btn-done-help\" class=\"btn btn-primary btn-block\">\n            <span>Got It, Let's Play</span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ACHIEVEMENTS MODAL -->\n    <div id=\"modal-achievements\" class=\"modal-window modal-window-achievements\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"achievements-modal-title\">\n      <div class=\"modal-card modal-scrollable\">\n        <div class=\"modal-header\">\n          <div class=\"modal-title-wrap\">\n            <div class=\"header-badge-row\">\n              <h2 id=\"achievements-modal-title\" class=\"modal-title\">Achievements</h2>\n              <span id=\"modal-achievements-progress-pill\" class=\"badge-pill\">0 / 15 Unlocked</span>\n            </div>\n            <p class=\"modal-subtitle\">Milestones, streaks & challenges.</p>\n          </div>\n          <button id=\"btn-close-achievements\" class=\"btn-icon\" aria-label=\"Close Achievements\">\n            <i class=\"fa-solid fa-xmark\"></i>\n          </button>\n        </div>\n\n        <div class=\"modal-body\">\n          <!-- Filter Tabs -->\n          <div class=\"achieve-filter-bar\">\n            <button type=\"button\" class=\"filter-tab active\" data-filter=\"all\">All (15)</button>\n            <button type=\"button\" class=\"filter-tab\" data-filter=\"unlocked\">Unlocked</button>\n            <button type=\"button\" class=\"filter-tab\" data-filter=\"locked\">In Progress</button>\n          </div>\n\n          <!-- List of 15 Achievements -->\n          <div id=\"achievements-list\" class=\"achievements-list\">\n            <!-- Populated dynamically by JavaScript -->\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button id=\"btn-done-achievements\" class=\"btn btn-primary btn-block\">\n            <span>Back to Game</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Custom Confirmation Dialog -->\n  <div id=\"confirm-dialog\" class=\"confirm-dialog-overlay\" aria-hidden=\"true\">\n    <div class=\"confirm-dialog-card\">\n      <h3 id=\"confirm-title\" class=\"confirm-title\">Are you sure?</h3>\n      <p id=\"confirm-message\" class=\"confirm-message\">This action cannot be undone.</p>\n      <div class=\"confirm-actions\">\n        <button id=\"confirm-btn-cancel\" class=\"btn btn-secondary\">Cancel</button>\n        <button id=\"confirm-btn-ok\" class=\"btn btn-danger\">Confirm</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Top Toast Notification Container (Achievements Only - Upper Center) -->\n  <div id=\"achievement-toast-container\" class=\"achievement-toast-container\" aria-live=\"assertive\"></div>\n\n  <!-- Bottom Toast Notification Container (Gameplay Items, Status & Alerts - Lower Center) -->\n  <div id=\"toast-container\" class=\"toast-container\" aria-live=\"polite\"></div>\n\n  <!-- Application Logic -->\n  <script src=\"js/app.js\"></script>\n</body>\n</html>\n",
    "features": [
      "aprendido_web"
    ]
  }
